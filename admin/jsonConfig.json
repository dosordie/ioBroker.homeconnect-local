{
  "type": "tabs",
  "i18n": true,
  "items": {
    "main": {
      "type": "panel",
      "label": "Main settings",
      "items": {
        "profilePath": {
          "type": "text",
          "label": "Profile directory path",
          "help": "Absolute container path to a directory containing Home Connect profile ZIP files. A single ZIP or extracted profile directory is still supported.",
          "sm": 12,
          "md": 12
        },
        "autoAddProfiles": {
          "type": "checkbox",
          "label": "Automatically add scanned profiles to the device table",
          "help": "New profiles are added as disabled device suggestions. Existing enabled, host and haId values are preserved.",
          "sm": 12,
          "md": 12
        },
        "appName": {
          "type": "text",
          "label": "App name",
          "sm": 12,
          "md": 6
        },
        "appId": {
          "type": "text",
          "label": "App ID",
          "sm": 12,
          "md": 6
        },
        "reconnectInterval": {
          "type": "number",
          "label": "Reconnect interval in seconds",
          "min": 5,
          "sm": 12,
          "md": 6
        },
        "debugRaw": {
          "type": "checkbox",
          "label": "Create raw uid states and log received /ro values",
          "sm": 12,
          "md": 6
        },
        "devices": {
          "type": "table",
          "label": "Appliances",
          "help": "Only Enabled, Name and IP or host should normally be edited. The other columns are filled from the scanned profile ZIP files.",
          "items": [
            {
              "attr": "enabled",
              "type": "checkbox",
              "title": "Enabled",
              "width": "90"
            },
            {
              "attr": "name",
              "type": "text",
              "title": "Name",
              "width": "260"
            },
            {
              "attr": "host",
              "type": "text",
              "title": "IP or host",
              "width": "170"
            },
            {
              "attr": "haId",
              "type": "text",
              "title": "Profile haId",
              "width": "320",
              "readOnly": true
            },
            {
              "attr": "type",
              "type": "text",
              "title": "Type",
              "width": "130",
              "readOnly": true
            },
            {
              "attr": "brand",
              "type": "text",
              "title": "Brand",
              "width": "120",
              "readOnly": true
            },
            {
              "attr": "vib",
              "type": "text",
              "title": "VIB",
              "width": "150",
              "readOnly": true
            },
            {
              "attr": "connectionType",
              "type": "text",
              "title": "Connection",
              "width": "120",
              "readOnly": true
            },
            {
              "attr": "profileFile",
              "type": "text",
              "title": "Profile file",
              "width": "520",
              "readOnly": true
            }
          ]
        }
      }
    }
  }
}
